{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortableFidoVault",
  "version": "0.1.0",
  "identifier": "com.skycity.portable-fido-vault",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "可攜式 FIDO2 密碼金庫",
        "width": 1000,
        "height": 660,
        "minWidth": 820,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
